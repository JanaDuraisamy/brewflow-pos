# ---------------------------------------------------------------------------
# BrewFlow POS — Environment Template
# ---------------------------------------------------------------------------
# Copy this file to `.env` and replace the placeholders with real values.
#
#   cp .env.example .env          (or on Windows: copy .env.example .env)
#
# The real `.env` file is gitignored — NEVER commit it.
# Only this template (.env.example) is tracked in source control.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Project URL from Supabase dashboard: Settings -> API.
SUPABASE_URL=https://your-project-ref.supabase.co

# Public "anon" key from Supabase dashboard: Settings -> API.
# This key is meant for client-side use and is protected by Row Level Security.
SUPABASE_ANON_KEY=your-supabase-anon-key
