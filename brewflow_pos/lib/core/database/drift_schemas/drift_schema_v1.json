    {
      "name": "users",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"users\" (\"id\" TEXT NOT NULL, \"email\" TEXT NOT NULL UNIQUE, \"display_name\" TEXT NULL, \"role\" TEXT NULL, \"is_active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_active\" IN (0, 1)), \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL UNIQUE, \"is_active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_active\" IN (0, 1)), \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "products",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"products\" (\"id\" TEXT NOT NULL, \"category_id\" TEXT NOT NULL REFERENCES categories (id) ON DELETE RESTRICT, \"name\" TEXT NOT NULL, \"sku\" TEXT NULL UNIQUE, \"selling_price_paise\" INTEGER NOT NULL CHECK (selling_price_paise >= 0), \"cost_price_paise\" INTEGER CHECK (cost_price_paise IS NULL OR cost_price_paise >= 0), \"stock_quantity\" INTEGER NOT NULL DEFAULT 0 CHECK (stock_quantity >= 0), \"is_active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_active\" IN (0, 1)), \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL);"
        }
      ]
